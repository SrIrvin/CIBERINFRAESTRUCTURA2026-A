## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
##
## This .gitignore file can be used for any Visual Studio project.

# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (DotSettings)
*.ControlSpy
*.DotSettings.user

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][In][32]/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
Log/
logs/

# Visual Studio 2015/2017/2019/2022 cache/options directory
.vs/
# Uncomment if you use Visual Studio Code
.vscode/

# MSTest test Results
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# NUnit
/*.VisualState.xml

# Build Tasks
Internal/

# Redgate extensions
*.vcrender.user

# Visual Studio Profiler
*.psess
*.vsp
*.vspx
*.sap

# Visual Studio Trace Log
*.utp

# ReSharper is a .NET coding add-in
_ReSharper*/
*.[Rr]e[Ss]harper
*.DotSettings.user

# JustCode is a .NET coding add-in
.JustCode

# TeamCity is a build automation system
_TeamCity*

# DotCover is a Code Coverage Tool
*.dotCover

# AxoCover is a Code Coverage Tool
.axoCover
/*_AxoCover.log

# Coverlet is a Code Coverage Tool
coverage/*.json
coverage/*.xml
coverage/*.info

# Visual Studio code coverage results
*.coverage
*.coveragexml

# NCrunch
_NCrunch_*
.*crunch*.local.xml
nCrunchTemp_*

# MightyMoose
*.mm.*
AutoTest.Net/

# Web workbench (sass)
.sass-cache/

# Installshield output folder
[Ee]xpress/

# DocProject is a documentation generator add-in
DocProject/buildhelp/
DocProject/Help/*.HxT
DocProject/Help/*.HxC
DocProject/Help/*.hhc
DocProject/Help/*.hhk
DocProject/Help/*.hhp
DocProject/Help/Html2
DocProject/Help/html

# ClickOnce directory
publish/

# Publish Web Output
*.[Pp]ublish.xml
*.azurePubxml
# Note: Comment the next line if you want to checkin your web deploy settings,
# but be aware that they can contain sensitive information.
*.pubxml
*.publishproj

# Microsoft Azure Web App publish settings. Comment the next line if you want to
# checkin your Microsoft Azure Web App publish settings, but be aware that they can
# contain sensitive information.
*.PublishSettings

# Sencha Ext JS project
.sencha/

# Microsoft Azure Build Output
csx/
*.build.csdef

# Microsoft Azure Cloud Service Projects
ecf/
rcf/

# Azure Stream Analytics
ASATemp/

# Node.js
node_modules/
npm-debug.log
yarn-error.log

# Visual Studio 6 build log
*.plg

# Visual Studio 6 spack file
*.pdb

# Visual Studio 6 Guid files
*.vbid

# Oracle's Visual Studio plugin
*.unsealed
*.ncb

# Backup & report files from converting an older solution
# to a newer Visual Studio version. Inspect them if you
# are not sure whether you should check them in or not.
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm
ServiceFabricBackup/
*.rptproj.bak

# SQL Server files
*.mdf
*.ldf
*.ndf

# Business Intelligence projects
*.rdl.data
*.bim.layout
*.bim_*.settings
*.rptproj.rsuser
*- [Bb]ackup.rdl
*- [Bb]ackup ([0-9]).rdl
*- [Bb]ackup ([0-9][0-9]).rdl

# Microsoft Fakes
FakesAssemblies/

# GhostDoc plugin for Visual Studio
*.GhostDoc.xml

# Node.js Tools for Visual Studio
.ntvs_analysis.dat
node_modules/

# Visual Studio 6 folder
Visual Studio 6/

# Visual Studio LightSwitch build output
**/*.HTMLClient/GeneratedArtifacts
**/*.DesktopClient/GeneratedArtifacts
**/*.DesktopClient/ModelManifest.xml
**/*.Server/GeneratedArtifacts
**/*.Server/ModelManifest.xml
_Pvt_Extensions

# Paket dependency manager
.paket/paket.exe
obj/

# FAKE - F# Make
.fake/

# CodeRush personal settings
.cr/personal

# Python Tools for Visual Studio
__pycache__/
*.pyc

# Telerik UI for ASP.NET MVC
Telerik.ReportViewer.axd

# BOWER
bower_components/

# NuGet Packages
*.nupkg
# NuGet Symbol Packages
*.snupkg
# Custom NuGet mirror settings
NuGet.Config
# The packages folder can be ignored because of Package Restore
**/[Pp]ackages/*
# except build/, which is used as an MSBuild target.
!**/[Pp]ackages/build/
# Uncomment if using NuGet Localization
# !**/[Pp]ackages/Microsoft.CodeAnalysis.Analyzers.*/

# Microsoft Azure Service Fabric
**/[Pp]ublishProfiles/*.xml
**/[Aa]pplicationParameters/*.xml

# Rider
.idea/
*.sln.iml

# JustMock
*.jmconfig

# Benchmarking
BenchmarkDotNet.Artifacts/

# Others
ClientBin/
~$*
*~
*.dbmdl
*.dbproj.schemaview
*.jfm
*.pfx
*.publishsettings
orleans.codegenerator.cs

# Including .env files by default is a security risk
.env
.env.test
.env.production
.env.local
.env.*.local

# End of .gitignore
